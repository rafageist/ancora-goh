    {"type": "room_assignment", "key": "P1.A1@L1", "as": "alice", "template": "P1.A1", "room": "L1", "priority": 1},
    {"type": "room_assignment", "key": "P1.B1@L1", "as": "alice", "template": "P1.B1", "room": "L1", "priority": 1},

    {"type": "plan", "key": "P2", "as": "alice", "label": "Semester 1, evening", "starts_on": "2026-09-07", "duration_days": 30},
    {"type": "period", "key": "W2", "as": "alice", "plan": "P2", "label": "Week", "days": 5, "slots_per_day": 2, "start_hour": 8, "slot_duration": 1, "plan_days": [1]},
