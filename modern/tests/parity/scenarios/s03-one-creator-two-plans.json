{
  "schema": "ancora.parity.scenario.v1",
  "id": "s03-one-creator-two-plans",
  "title": "One creator with two plans that share the catalogues (subjects, teacher, room, cohort)",
  "notes": [
    "Legacy: subjects, teachers, rooms, cohorts, activity types, specialties and levels belong to their creador and serve every plan of that creador. The second plan's period gets breakdown rows for the creador's existing subjects from the trigger nuevo_desglose_si_nuevo_periodo.",
    "Both plans cover the same days and share the teacher and the room. Observed on both sides: the second run places them in the same day and slots as the first run (P1: A1 day 1 slot 1, B1 slot 2; P2: B1 slot 1, A1 slot 2); the first plan's placements do not make them busy for the second.",
    "The cohort is in a group of each plan (mueve_o_crea_brigada_de_grupo only moves it between groups of the same plan)."
  ],
  "users": [
    {"key": "admin", "name": "Administrator", "legacy": "seeded-admin"},
    {"key": "alice", "name": "Alice Planner"}
  ],
  "records": [
    {"type": "plan", "key": "P1", "as": "alice", "label": "Semester 1", "starts_on": "2026-09-07", "duration_days": 30},
    {"type": "period", "key": "W1", "as": "alice", "plan": "P1", "label": "Week", "days": 5, "slots_per_day": 2, "start_hour": 8, "slot_duration": 1, "plan_days": [1]},
    {"type": "activity_type", "key": "C1", "as": "alice", "label": "Lecture", "duration_slots": 1, "priority": 1, "cost": 1},
    {"type": "specialty", "key": "E", "as": "alice", "label": "Program"},
    {"type": "level", "key": "N", "as": "alice", "label": "Year 1"},
    {"type": "cohort", "key": "B1", "as": "alice", "label": "Cohort 1", "specialty": "E", "level": "N", "enrollment": 20},
    {"type": "student_group", "key": "P1.G1", "code": "G1", "as": "alice", "plan": "P1", "label": "Group 1", "activity_type": "C1", "specialty": "E", "level": "N", "cohorts": ["B1"]},
    {"type": "subject", "key": "A", "as": "alice", "label": "Subject Alpha", "specialty": "E", "level": "N"},
    {"type": "subject", "key": "B", "as": "alice", "label": "Subject Beta", "specialty": "E", "level": "N"},
    {"type": "activity_template", "key": "P1.A1", "as": "alice", "subject": "A", "period": "W1", "sequence": 1, "activity_type": "C1"},
    {"type": "activity_template", "key": "P1.B1", "as": "alice", "subject": "B", "period": "W1", "sequence": 1, "activity_type": "C1"},
