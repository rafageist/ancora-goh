<?php

/**
 * @file
 * Install, update and uninstall functions for the Áncora engine module.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 *
 * The job table lives in the site's Drupal database. The engine database of
 * the site holds only the legacy MPI/Prioriza schema; nothing of Drupal is
 * ever created there.
 */
function ancora_engine_schema(): array {
  $schema['ancora_engine_job'] = [
    'description' => 'Timetable generation jobs run by the engine worker.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uuid' => [
        'type' => 'varchar_ascii',
        'length' => 36,
        'not null' => TRUE,
      ],
      'scope_specialty' => [
        'description' => 'Specialty id in the engine database.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'scope_level' => [
        'description' => 'Level id in the engine database.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'scope_period' => [
        'description' => 'Period id in the engine database.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'plan_id' => [
        'description' => 'Drupal plan (ancora_plan) whose data the worker syncs into the engine before the run; NULL when the data is already in the engine database.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'period_id' => [
        'description' => 'Drupal period (ancora_period) of a synced job.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'specialty_id' => [
        'description' => 'Drupal specialty (ancora_specialty) of a synced job.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'level_id' => [
        'description' => 'Drupal level (ancora_level) of a synced job.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'id_prefix' => [
        'description' => 'Prefix of every engine id of the synced plan.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => FALSE,
      ],
      'options' => [
        'description' => 'Validated generar() options, JSON.',
        'type' => 'text',
        'not null' => TRUE,
      ],
      'time_limit' => [
        'description' => 'statement_timeout of the run, in seconds.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'state' => [
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => TRUE,
      ],
      'cancel_requested' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'cancel_mode' => [
        'description' => 'soft (generador.cancelar) or hard (pg_cancel_backend).',
        'type' => 'varchar_ascii',
        'length' => 8,
        'not null' => FALSE,
      ],
      'requested_by' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'cancelled_by' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'retry_of' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'started' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'finished' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'heartbeat' => [
        'type' => 'int',
        'not null' => FALSE,
      ],
      'worker_id' => [
        'type' => 'varchar_ascii',
        'length' => 128,
        'not null' => FALSE,
      ],
      'attempts' => [
        'description' => 'Number of claims; also the fencing token of a run.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'result' => [
        'description' => 'Metrics of the run, JSON.',
        'type' => 'text',
        'not null' => FALSE,
      ],
      'error' => [
        'description' => 'Error summary without secrets.',
        'type' => 'varchar',
        'length' => 1024,
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uuid' => ['uuid'],
    ],
    'indexes' => [
      'state' => ['state', 'id'],
      'created' => ['created'],
      'source' => ['plan_id', 'period_id', 'id'],
    ],
  ];
  return $schema;
}

/**
 * Implements hook_install().
 *
 * At most one running job per site, enforced by the database: a partial
 * unique index (PostgreSQL), in addition to the claim lock of the worker.
 */
function ancora_engine_install(): void {
  $connection = \Drupal::database();
  $index = $connection->getPrefix() . 'ancora_engine_job_one_running';
  $connection->query('CREATE UNIQUE INDEX "' . $index . '" ON {ancora_engine_job} (state) WHERE state = \'running\'');
}

/**
 * Adds the source columns: the Drupal plan, period, specialty and level.
 */
function ancora_engine_update_11001(): string {
  $schema = \Drupal::database()->schema();
  $fields = ancora_engine_schema()['ancora_engine_job']['fields'];
  foreach (['plan_id', 'period_id', 'specialty_id', 'level_id', 'id_prefix'] as $name) {
    if (!$schema->fieldExists('ancora_engine_job', $name)) {
      $schema->addField('ancora_engine_job', $name, $fields[$name]);
    }
  }
  if (!$schema->indexExists('ancora_engine_job', 'source')) {
    $schema->addIndex('ancora_engine_job', 'source', ['plan_id', 'period_id', 'id'], ancora_engine_schema()['ancora_engine_job']);
  }
  return 'Added the source columns of synced jobs.';
}
