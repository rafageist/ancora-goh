<?php

/**
 * @file
 * Install and update functions for the Áncora scheduling module.
 */

declare(strict_types=1);

/**
 * Adds the placement entity type (#95, workspace mode).
 *
 * It only creates the empty table "ancora_placement". The two-database mode
 * does not use it, and no data is migrated.
 */
function ancora_scheduling_update_11001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getEntityType('ancora_placement') === NULL) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('ancora_placement'));
    return 'Installed the placement entity type.';
  }
  return 'The placement entity type is already installed.';
}

/**
 * Stores the placement moment in double precision (#96).
 *
 * The engine's momento_de_colocacion is double precision. Stored as a
 * single precision "float" it lost its hour part (8463176.47 became
 * 8463176). The column is widened in place; existing values cannot regain
 * the lost digits.
 */
function ancora_scheduling_update_11002(): string {
  $key_value = \Drupal::keyValue('entity.storage_schema.sql');
  $key = 'ancora_placement.field_schema_data.placed_at';
  $installed = $key_value->get($key);
  if (($installed['ancora_placement']['fields']['placed_at']['size'] ?? NULL) === 'big') {
    return 'The placement moment is already double precision.';
  }
  $spec = $installed['ancora_placement']['fields']['placed_at'];
  $spec['size'] = 'big';
  \Drupal::database()->schema()->changeField('ancora_placement', 'placed_at', 'placed_at', $spec);
  $installed['ancora_placement']['fields']['placed_at'] = $spec;
  $key_value->set($key, $installed);
  return 'The placement moment is now double precision.';
}

/**
 * Implements hook_update_dependencies().
 */
function ancora_scheduling_update_dependencies(): array {
  // The other resources of a placement reference the entity type that
  // ancora_academic_update_11008() installs.
  return ['ancora_scheduling' => [11003 => ['ancora_academic' => 11008]]];
}

/**
 * Adds the other resources of a placement (#70, D9d).
 *
 * Legacy otros_recursos_usados: the resources the engine gave a placed
 * activity. Existing placements have none: no other resource existed in
 * Drupal before.
 */
function ancora_scheduling_update_11003(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if ($manager->getFieldStorageDefinition('other_resources', 'ancora_placement') !== NULL) {
    return 'The other resources of placements are already installed.';
  }
  $definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('ancora_placement');
  $manager->installFieldStorageDefinition('other_resources', 'ancora_placement', 'ancora_scheduling', $definitions['other_resources']);
  return 'Installed the other resources of placements.';
}
