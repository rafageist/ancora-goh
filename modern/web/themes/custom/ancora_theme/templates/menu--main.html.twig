{# Drupal's access-checked menu tree is the only application navigation. #}
{% import _self as menus %}
{{ menus.render(items, attributes, 0) }}
{% macro render(items, attributes, depth) %}
  {% if items %}
    <ul{{ attributes.addClass(depth == 0 ? 'ancora-menu' : 'ancora-menu__children') }}>
      {% for item in items %}
        <li{{ item.attributes.addClass('ancora-menu__item', item.in_active_trail ? 'is-active-trail') }}>
          {{ link(item.title, item.url, item.in_active_trail ? {'class': ['is-active-trail']} : {}) }}
          {{ _self.render(item.below, create_attribute(), depth + 1) }}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
