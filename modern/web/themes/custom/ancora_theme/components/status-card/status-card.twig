{#
/**
 * @file
 * Status card component.
 *
 * Props:
 * - heading: (optional) The card heading.
 * - items: A list of {label, value} pairs.
 */
#}
<section class="status-card">
  {% if heading %}
    <h2 class="status-card__heading">{{ heading }}</h2>
  {% endif %}
  <dl class="status-card__list">
    {% for item in items %}
      <div class="status-card__item">
        <dt class="status-card__label">{{ item.label }}</dt>
        <dd class="status-card__value">{{ item.value }}</dd>
      </div>
    {% endfor %}
  </dl>
</section>
