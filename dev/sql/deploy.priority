table: tiempo.restriccion.nominal.restriccion_por_actividad_de_otro_recurso @ Restriccion por actividad de otro recurso @ tiempo.restriccion.nominal.restriccion_de_otro_recurso, actividad.actividad
table: tiempo.restriccion.nominal.restriccion_por_actividad_de_brigada @ Restriccion por actividad de otro recurso @ tiempo.restriccion.nominal.restriccion_de_brigada, actividad.actividad
function: organizacion.dame_lista_id_brigadas_de_grupo @ Obtener la lista de id de las brigadas de un grupo @ organizacion.brigada_de_grupo, matrix.get_length_of, miscelanea.crear_id_de_replica, tiempo.restriccion.nominal.restriccion_de_brigada, tiempo.restriccion.nominal.restriccion_por_actividad_de_brigada, tiempo.restriccion.nominal.restriccion_de_profesor, tiempo.restriccion.nominal.restriccion_por_actividad_de_profesor, tiempo.restriccion.nominal.restriccion_de_lugar, tiempo.restriccion.nominal.restriccion_por_actividad_de_lugar 
