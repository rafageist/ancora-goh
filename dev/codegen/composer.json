{
    "name": "ancora-goh/divengine-codegen",
    "description": "Divengine Codegen (formerly cogePHP): model-driven PHP and SQL code generator rendered from Div templates",
    "type": "project",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Rafael Rodríguez Ramírez",
            "role": "Original author of cogePHP (2010)"
        }
    ],
    "require": {
        "php": ">=8.4",
        "divengine/div": "^6.1.3"
    },
    "autoload": {
        "psr-4": {
            "Divengine\\Codegen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Divengine\\Codegen\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/divengine-codegen"
    ],
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
