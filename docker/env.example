# Local settings for compose.yaml. Copy to .env in the repository root
# (git-ignored): cp docker/env.example .env
#
# Host port of the web application.
ANCORA_HTTP_PORT=8087

# Host address the port is published on. Default 127.0.0.1 (this computer
# only). 0.0.0.0 publishes it on every interface, so every device on your
# network can reach it. The application is NOT safe on a network yet (SQL
# injection, no CSRF protection, no output escaping): only on a trusted LAN,
# never on the internet. Docker's published ports bypass ufw rules.
#ANCORA_BIND_ADDRESS=127.0.0.1

# Database and application role created by "docker/manage.sh init-db".
# Change them only before the first initialization.
ANCORA_DB_NAME=ancoragoh
ANCORA_DB_USER=ancoragoh

# Directory with the postgres_password and db_password files
# (docker/manage.sh init-secrets). Default: ./secrets
#ANCORA_SECRETS_DIR=./secrets
