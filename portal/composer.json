{
    "name": "divengine/timetables-portal",
    "description": "Public information and access-request portal for timetables.divengine.com (R0).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-mbstring": "*",
        "psr/log": "^3.0"
    },
    "suggest": {
        "ext-curl": "Required by the Postmark mail driver"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "Ancora\\Portal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ancora\\Portal\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint-style": "phpcs"
    }
}
