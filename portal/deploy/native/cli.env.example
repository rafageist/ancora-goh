# /etc/divengine/timetables/cli.env (0640 root:timetables): environment of the
# operator CLI and the purge timer. Same values as the FPM pool.
PORTAL_BASE_URL=https://timetables.divengine.com
PORTAL_DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=timetables_control
PORTAL_DB_USER=tt_control_app
PORTAL_DB_PASSWORD_FILE=/etc/divengine/timetables/db_password
PORTAL_SECRET_FILE=/etc/divengine/timetables/hmac
PORTAL_MAIL_DRIVER=postmark
PORTAL_POSTMARK_TOKEN_FILE=/etc/divengine/timetables/postmark_token
PORTAL_MAIL_FROM=SET_BY_MAINTAINER
