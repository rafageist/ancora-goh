[Unit]
Description=Timetables portal: daily backup of timetables_control (14 days kept)
After=postgresql.service

[Service]
Type=oneshot
User=postgres
UMask=0077
ExecStart=/bin/sh -c 'f=/var/backups/timetables/timetables_control-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).dump && pg_dump -Fc -d timetables_control -f "$f" && find /var/backups/timetables -name "timetables_control-*.dump" -mtime +14 -delete'
NoNewPrivileges=yes
