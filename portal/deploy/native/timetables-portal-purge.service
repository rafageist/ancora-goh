[Unit]
Description=Timetables portal: apply the retention rules of the privacy notice
After=postgresql.service

[Service]
Type=oneshot
User=timetables
EnvironmentFile=/etc/divengine/timetables/cli.env
ExecStart=/usr/bin/php8.5 /opt/divengine/timetables/portal/bin/portal purge
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
